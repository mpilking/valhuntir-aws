<powershell>
# Windows wintools-mcp first boot.
#
# Joins the SIFT gateway with upstream's own unattended flow:
#   SIFT first boot mints a one-time join code, configures its Samba case share
#   for this host's IP, and publishes the code to SSM Parameter Store. Here we
#   wait for it and run setup-windows.ps1 -NonInteractive -JoinCode, which
#   generates this host's bearer token + TLS cert, registers wintools-mcp with
#   the gateway (the gateway hot-loads it), maps the case share, and installs the
#   startup scheduled task. Nothing secret is baked into the AMI.
#
# Checkpoint deploys launch an AMI where install-windows.ps1 already staged the
# pinned code + Python environment and install-windows-tools.ps1 the forensic
# tools; checkpoint=latest installs the newest of both here.

Start-Transcript -Path C:\ProgramData\valhuntir\firstboot.log -Append
$ErrorActionPreference = "Stop"
$ProgressPreference = "SilentlyContinue"

$Region    = "${region}"
$SiftIp    = "${sift_ip}"
$Examiner  = "${examiner_name}"
$CodeParam = "${join_code_param}"
$Install   = "C:\Tools\vhir"
$Wintools  = Join-Path $Install "wintools-mcp"

function Update-Path {
  $env:Path = [Environment]::GetEnvironmentVariable("Path","Machine") + ";" + [Environment]::GetEnvironmentVariable("Path","User") }

try {
%{ if !baked ~}
  # --- 0. checkpoint=latest: newest Git for Windows + Python (official
  # installers); setup-windows.ps1 then clones wintools-mcp main itself ---------
  [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
  function Install-Exe { param([string]$Url, [string[]]$InstallArgs)
    $exe = Join-Path $env:TEMP (Split-Path $Url -Leaf)
    Invoke-WebRequest -UseBasicParsing -Uri $Url -OutFile $exe
    $p = Start-Process -FilePath $exe -ArgumentList $InstallArgs -Wait -PassThru
    if ($p.ExitCode -ne 0) { throw "$Url installer exited $($p.ExitCode)" } }
  $rel = Invoke-RestMethod https://api.github.com/repos/git-for-windows/git/releases/latest
  $gitUrl = ($rel.assets | Where-Object { $_.name -match '^Git-[\d.]+-64-bit\.exe$' } | Select-Object -First 1).browser_download_url
  Install-Exe $gitUrl @("/VERYSILENT", "/NORESTART", "/NOCANCEL", "/SP-", "/SUPPRESSMSGBOXES")
  # Newest Python in the series setup-windows.ps1 recommends (3.12), not the
  # newest Python: a brand-new minor (3.15.0) had no wheels for wintools' deps.
  $vers = (Invoke-WebRequest -UseBasicParsing https://www.python.org/ftp/python/).Links.href |
    Where-Object { $_ -match '^3\.12\.\d+/$' } | ForEach-Object { [version]$_.TrimEnd("/") } | Sort-Object -Descending
  foreach ($v in $vers) {
    $u = "https://www.python.org/ftp/python/$v/python-$v-amd64.exe"
    try { Invoke-WebRequest -UseBasicParsing -Method Head $u | Out-Null; $pyUrl = $u; break } catch { }
  }
  Install-Exe $pyUrl @("/quiet", "InstallAllUsers=1", "PrependPath=1", "Include_test=0")
  Update-Path
  New-Item -ItemType Directory -Force -Path $Install | Out-Null
  if (-not (Test-Path $Wintools)) { git clone --quiet https://github.com/AppliedIR/wintools-mcp.git $Wintools }

  # Newest forensic tools: the same install-windows-tools.ps1 Packer bakes,
  # embedded gzip+base64, with every version "latest".
  $gz = [IO.MemoryStream]::new([Convert]::FromBase64String("${tools_script_b64}"))
  $rd = [IO.StreamReader]::new([IO.Compression.GZipStream]::new($gz, [IO.Compression.CompressionMode]::Decompress))
  $toolsScript = "C:\ProgramData\valhuntir\install-windows-tools.ps1"
  Set-Content -Path $toolsScript -Value $rd.ReadToEnd() -Encoding UTF8
  $latest = @{}
  foreach ($k in "dotnet_runtime","zimmerman","sysinternals","hayabusa","chainsaw","capa","yara","densityscout",
                 "winpmem","moneta","hollows_hunter","get_injectedthreadex","strawberry_perl","sleuthkit") { $latest[$k] = "latest" }
  $env:WINDOWS_TOOLS_B64 = [Convert]::ToBase64String([Text.Encoding]::UTF8.GetBytes(($latest | ConvertTo-Json -Compress)))
  & powershell -NoProfile -ExecutionPolicy Bypass -File $toolsScript *>&1 | ForEach-Object { "$_" }
  if ($LASTEXITCODE -ne 0) { throw "install-windows-tools.ps1 failed ($LASTEXITCODE)" }
%{ endif ~}
  Update-Path

  # --- 1. Wait for SIFT to publish the join code (SIFT may still be booting) ---
  $join = $null
  for ($i = 0; $i -lt 360; $i++) {   # up to 3 h (checkpoint=latest SIFT installs take ~1.5 h)
    try {
      $v = (Get-SSMParameter -Name $CodeParam -WithDecryption $true -Region $Region).Value
      if ($v -and $v -ne "pending") { $join = $v | ConvertFrom-Json; break }
    } catch { Write-Output "waiting for join code: $_" }
    Start-Sleep -Seconds 30
  }
  if (-not $join.code) { throw "no join code from SIFT after 3 h" }

  # Trust this deployment's gateway CA (generated on SIFT at its first boot), so
  # setup-windows.ps1's HTTPS health check and join call verify the gateway.
  $caFile = "C:\ProgramData\valhuntir\sift-gateway-ca.pem"
  Set-Content -Path $caFile -Value $join.ca_cert -Encoding ASCII
  Import-Certificate -FilePath $caFile -CertStoreLocation Cert:\LocalMachine\Root | Out-Null

  # --- 2. Upstream unattended install + join ------------------------------------
  # No -StaticIP: on EC2 the address is fixed by Terraform, and the NIC must stay DHCP.
  # Its console output is piped through so it lands in this transcript.
  & powershell -NoProfile -ExecutionPolicy Bypass -File (Join-Path $Wintools "scripts\setup-windows.ps1") `
    -NonInteractive -AcknowledgeSecurityHole -InstallDir $Install -Examiner $Examiner `
    -BindAddress 0.0.0.0 -Port 4624 -GatewayHost $SiftIp -GatewayPort 4508 -JoinCode $join.code *>&1 |
    ForEach-Object { "$_" }
  if ($LASTEXITCODE -ne 0) { throw "setup-windows.ps1 failed ($LASTEXITCODE)" }

  # --- 3. Firewall: wintools-mcp only from SIFT ---------------------------------
  New-NetFirewallRule -DisplayName "wintools-mcp 4624 from SIFT" -Direction Inbound `
    -Protocol TCP -LocalPort 4624 -RemoteAddress $SiftIp -Action Allow | Out-Null

  # --- 3b. Defender: never quarantine evidence on the case share -----------------
  # Without this, Defender blocks tools from reading flagged evidence over SMB
  # and tries to delete it from SIFT's case directory (tested with EICAR).
  # Defender sees network files by UNC path; S: is the drive setup-windows.ps1 maps.
  Add-MpPreference -ExclusionPath "\\$SiftIp\cases", "S:\"

  # --- 3c. Keep S: connected across logons ---------------------------------------
  # setup-windows.ps1 maps S: with `net use /persistent:yes`, which saves the
  # mapping but not the vhir-smb password, so every new logon shows S:
  # disconnected and prompts. Store the credential (from wintools' own config)
  # in this account's vault. wintools-mcp itself doesn't need this.
  $smbPw = (Select-String (Join-Path $Wintools "config.yaml") -Pattern '^smb_password:\s*(.+)$').Matches[0].Groups[1].Value
  $null = cmdkey /add:$SiftIp /user:vhir-smb /pass:$smbPw
  if ($LASTEXITCODE -ne 0) { Write-Output "WARNING: cmdkey failed ($LASTEXITCODE); S: will prompt for the vhir-smb password" }
  $smbPw = $null

  # --- 4. Health: the server must be listening ----------------------------------
  $up = $false
  for ($i = 0; $i -lt 30; $i++) {
    if (Get-NetTCPConnection -LocalPort 4624 -State Listen -ErrorAction SilentlyContinue) { $up = $true; break }
    Start-Sleep -Seconds 5
  }
  if (-not $up) { throw "wintools-mcp is not listening on :4624" }
  Write-Output "valhuntir-firstboot complete"
} catch {
  Write-Output "ERROR: $_"
  exit 1
} finally {
  Stop-Transcript
}
</powershell>
