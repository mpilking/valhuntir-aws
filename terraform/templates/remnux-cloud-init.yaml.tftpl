#cloud-config
# REMnux worker first-boot configuration.
#
# The heavy install (cast REMnux salt run + Node remnux-mcp) lives in
# install-remnux.sh, embedded below. Checkpoint deploys launch an AMI Packer
# baked from the same script, so this document only writes the token env and
# enables the service; checkpoint=latest runs the install here first.

write_files:
  # systemd unit for the remnux-mcp HTTP server. The bootstrap creates
  # /etc/remnux-mcp.env and enables the unit.
  - path: /etc/systemd/system/remnux-mcp.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=REMnux MCP server (HTTP)
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      User=${remnux_user}
      EnvironmentFile=/etc/remnux-mcp.env
      ExecStart=/usr/bin/remnux-mcp-server --mode=local --transport=http --http-host=0.0.0.0 --http-port=3000
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=multi-user.target

%{ if !baked ~}
  # The heavy install script (single-sourced with Packer). Only executed here
  # when not baked.
  - path: /usr/local/sbin/install-remnux.sh
    permissions: "0755"
    owner: root:root
    encoding: gz+b64
    content: ${install_script_b64}
%{ endif ~}

  - path: /usr/local/sbin/remnux-firstboot.sh
    permissions: "0750"
    owner: root:root
    content: |
      #!/usr/bin/env bash
      # No xtrace: this script handles secrets. Log is root-only; failures name
      # the line and the (unexpanded) command.
      set -euo pipefail
      install -m 600 /dev/null /var/log/remnux-firstboot.log
      exec > /var/log/remnux-firstboot.log 2>&1
      trap 'echo "ERROR: line $LINENO: $BASH_COMMAND" >&2' ERR

      REGION="${region}"
      SECRET_ARN="${secret_arn}"
      REMNUX_USER="${remnux_user}"

      %{ if !baked ~}
      # --- 1. Heavy install (checkpoint=latest) — cast REMnux + remnux-mcp --
      echo "== 1. Heavy install (checkpoint=latest) — cast REMnux + remnux-mcp"
      REMNUX_USER="$REMNUX_USER" REMNUX_MODE="${remnux_mode}" CAST_VER="${pins.cast}" \
        REMNUX_SALTSTACK_VERSION="${pins.remnux_saltstack}" NODEJS_VERSION="${pins.nodejs}" \
        REMNUX_MCP_VERSION="${pins.remnux_mcp_server}" AWSCLI_VERSION="${pins.awscli}" \
        /usr/local/sbin/install-remnux.sh
      %{ endif ~}

      # --- 2. Shared HTTP token from Secrets Manager ------------------------
      echo "== 2. Shared HTTP token from Secrets Manager"
      SECRET=$(aws --region "$REGION" secretsmanager get-secret-value \
        --secret-id "$SECRET_ARN" --query SecretString --output text)
      MCP_TOKEN=$(echo "$SECRET" | jq -r .remnux_mcp_token)
      # Fail closed: without a token the server would need --insecure-no-auth.
      [ "$${#MCP_TOKEN}" -ge 32 ] || { echo "ERROR: remnux_mcp_token missing" >&2; exit 1; }
      install -m 0640 -o root -g "$REMNUX_USER" /dev/null /etc/remnux-mcp.env
      echo "MCP_TOKEN=$MCP_TOKEN" > /etc/remnux-mcp.env

      # --- 3. Enable the service --------------------------------------------
      echo "== 3. Enable the service"
      systemctl daemon-reload
      systemctl enable --now remnux-mcp.service

      # --- 4. Health: /mcp must answer, and refuse a request without the token
      for i in $(seq 1 30); do
        code=$(curl -s -o /dev/null -w '%%{http_code}' -m 5 -X POST http://127.0.0.1:3000/mcp || true)
        [ "$code" = 401 ] && break; sleep 2
      done
      [ "$code" = 401 ] || { echo "ERROR: remnux-mcp not healthy (HTTP $code)" >&2; exit 1; }

      echo "remnux-firstboot complete"

runcmd:
  - /usr/local/sbin/remnux-firstboot.sh
